<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24550" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24550"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="OwnedCalendarResourceController">
            <connections>
                <outlet property="advancedRow" destination="rC0-ab-001" id="rC0-ab-005"/>
                <outlet property="advancedToggle" destination="rC0-ab-002" id="rC0-ab-006"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="rC0-ab-001" userLabel="Advanced Calendar Row">
            <rect key="frame" x="0.0" y="0.0" width="240" height="40"/>
            <autoresizingMask key="autoresizingMask"/>
            <subviews>
                <button verticalHuggingPriority="750" id="rC0-ab-002">
                    <rect key="frame" x="8" y="8" width="220" height="24"/>
                    <autoresizingMask key="autoresizingMask"/>
                    <buttonCell key="cell" type="check" title="Advanced calendar state" bezelStyle="regularSquare" imagePosition="left" alignment="left" state="off" inset="2" id="rC0-ab-003">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="changeAdvancedState:" target="-2" id="rC0-ab-004"/>
                    </connections>
                </button>
            </subviews>
        </customView>
    </objects>
</document>
