{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://macscope.invalid/schema/envelope/1.0",
  "title":"macscope 1.0 envelope",
  "type":"object",
  "required":["schema_version","command","status","analysis_id","data","diagnostics","coverage"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "command":{"type":"string"},
    "status":{"enum":["complete","partial","failed","cancelled"]},
    "analysis_id":{"type":["string","null"]},
    "data":{},
    "address_selection":{"type":"object","required":["image_id","arch","address_space","runtime_va","load_slide","va"],"properties":{"image_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"arch":{"enum":["arm64","x86_64"]},"address_space":{"const":"ram"},"runtime_va":{"type":"string","pattern":"^0x[0-9a-f]{1,16}$"},"load_slide":{"type":"string","pattern":"^-?0x[0-9a-f]{1,16}$"},"va":{"type":"string","pattern":"^0x[0-9a-f]{1,16}$"}},"additionalProperties":false},
    "diagnostics":{"type":"array","items":{"type":"string"}},
    "coverage":{"type":"object","required":["scope","status","returned_count","known_total","next_cursor","truncation_reason"],"properties":{"scope":{"type":"string"},"status":{"enum":["complete","partial","unknown"]},"returned_count":{"type":"integer","minimum":0},"known_total":{"type":["integer","null"],"minimum":0},"next_cursor":{"type":["string","null"]},"truncation_reason":{"type":["string","null"]}},"additionalProperties":false},
    "error":{"type":"object","required":["code","message","affected_object","retryable","partial_results"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"affected_object":{"type":["string","null"]},"retryable":{"type":"boolean"},"partial_results":{}},"additionalProperties":false}
  },
  "additionalProperties":false
}
