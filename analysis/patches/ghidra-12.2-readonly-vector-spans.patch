+      uint4 flags = glb->symboltab->getProperty(address);
+      if ((flags & Varnode::readonly) == 0)
+        getScopeLocal()->queryProperties(address,1,Address(),flags);
+      if ((flags & (Varnode::readonly | Varnode::volatil)) != Varnode::readonly)
+        return false;
+    }
+  }
